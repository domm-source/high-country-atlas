---
import '../styles/global.css';
import SiteSearch from '../components/SiteSearch.astro';

interface Props { title: string; description?: string; wide?: boolean; jsonld?: object[]; image?: string }
const {
  title, wide = false, jsonld = [], image = '/og/default.png',
  description = 'Explore Victoria’s High Country — huts, campgrounds, walks, 4WD tracks, peaks and gold-rush towns, with a detailed topographic atlas.',
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
// Structured data for search engines: every page is part of the High Country website.
const graph = [
  { '@type': 'WebSite', '@id': new URL('/#website', Astro.site), name: 'High Country', alternateName: 'Explore High Country', url: new URL('/', Astro.site), inLanguage: 'en-AU' },
  ...jsonld,
];
const fullTitle = title === 'High Country' ? 'High Country — Victoria’s Alpine Atlas' : `${title} · High Country`;
const nav = [
  ['/map/', 'Atlas'], ['/favourites/', 'Favourites'], ['/huts/', 'Huts'], ['/campgrounds/', 'Camping'], ['/walks/', 'Walks'],
  ['/drives/', '4WD'], ['/peaks/', 'Peaks'], ['/towns/', 'Towns'],
];
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={pageUrl}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:type" content="website">
  <meta property="og:image" content={imageUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={imageUrl}>
  <meta property="og:locale" content="en_AU">
  <meta property="og:site_name" content="High Country">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ccircle cx='8' cy='8' r='7.5' fill='%23ffcf3d' stroke='%23141210'/%3E%3Cpath d='M2.5 12l3.5-6 2 3 2-4 3.5 7z' fill='%23141210'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,400..900;1,62..125,400..700&family=Bricolage+Grotesque:opsz,wght@12..96,600..800&display=swap" rel="stylesheet">
  <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
</head>
<body>
  <header class="site-header">
    <div class="bar">
      <a class="wordmark" href="/">High Country<span>Victoria’s Alpine Atlas</span></a>
      <nav aria-label="Main">
        {nav.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <SiteSearch />
    </div>
  </header>

  <main class:list={[{ wide }]}>
    <slot />
  </main>

  <footer class="site-footer">
    <p>
      Map data © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors (ODbL).
      Parks Victoria sites, walks and road closures © State of Victoria (DEECA),
      <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>, via <a href="https://discover.data.vic.gov.au/">DataVic</a>.
      Terrain: Mapzen / AWS Terrain Tiles. Tiles by <a href="https://openfreemap.org">OpenFreeMap</a>.
    </p>
    <p class="caveat">Conditions in the High Country change fast. Always check with Parks Victoria and VicEmergency before you head out.</p>
  </footer>
</body>
</html>
