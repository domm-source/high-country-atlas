{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "high-country-atlas.vercel.app" }],
      "destination": "https://www.explorehighcountry.com/:path*",
      "permanent": true
    }
  ]
}
